# TimeQ Native App — Environment Variables
# Copy to .env and fill in values before building

# ─── API URLs (one per build profile) ──────────────────────────────────────
# Development (local)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Preview (staging)
EXPO_PUBLIC_API_URL_PREVIEW=https://staging-api.timeq.app

# Production
EXPO_PUBLIC_API_URL_PROD=https://api.timeq.app

# ─── EAS ───────────────────────────────────────────────────────────────────
# Get this from expo.dev after creating your project
EAS_PROJECT_ID=

# ─── iOS Submit (fill for auto-submit) ─────────────────────────────────────
# Apple ID (email)
APPLE_ID=
# App Store Connect App ID (ascAppId)
ASC_APP_ID=
# Apple Team ID
APPLE_TEAM_ID=

# ─── Android Submit (fill for auto-submit) ─────────────────────────────────
# Path to Google Play service account JSON
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
