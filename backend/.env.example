# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets - Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# OAuth token encryption key — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Demo account credentials (set a strong random password in production)
DEMO_EMAIL=demo@plos.app
DEMO_PASSWORD=

# Stripe (freemium billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# AI providers (at least one required for Lumi)
AI_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth + Gmail integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Web Push notifications (auto-generated on first start if not set)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Ollama (optional, local AI)
OLLAMA_HOST=http://localhost:11434
